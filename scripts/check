#!/usr/bin/env zsh

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

python_cmd="python3"
if [[ -x ".venv/bin/python" ]]; then
  python_cmd=".venv/bin/python"
fi

typeset -a required_files=(
  "AGENTS.md"
  "CLAUDE.md"
  "README.md"
  "docs/ARCHITECTURE.md"
  "docs/architecture.md"
  "docs/design-docs/index.md"
  "docs/design-docs/human-ai-working-contract.md"
  "docs/design-docs/coke-working-contract.md"
  "docs/adr/README.md"
  "docs/adr/_template.md"
  "docs/adr/0001-canonical-repo-os-structure.md"
  "docs/adr/0002-retire-tasks-directory.md"
  "docs/adr/0003-consolidate-plans-to-superpowers.md"
  "docs/superpowers/plans/README.md"
  "docs/superpowers/plans/_template.md"
  "docs/issues/README.md"
  "docs/issues/_template.md"
  "docs/issues/issue-gc-state.yaml"
  "docs/product-specs/FEATURE_TREE.md"
  "docs/release-guide.md"
  "docs/RELEASE_CHECKLIST.md"
  "docs/fitness/README.md"
  "docs/fitness/coke-verification-matrix.md"
  "docs/fitness/surfaces.yaml"
  "docs/fitness/ownership-registry.yaml"
  "web/OWNERS.md"
  "scripts/check"
  "scripts/verify-surface"
  "scripts/suggest-verification"
  "scripts/review-trigger"
  "scripts/guardrails.py"
  "scripts/e2e/clean-rebuild-canonical-doc-sync.sh"
  "coke/app.py"
  "coke/schema.py"
  "migrations/env.py"
  "docker-compose.prod.yml"
)

missing=0

for file in "${required_files[@]}"; do
  if [[ -f "$file" ]]; then
    print "OK  $file"
  else
    print "MISS $file"
    missing=1
  fi
done

if [[ -e "docs/exec-plans" ]]; then
  print "MISS docs/exec-plans must stay retired; use docs/superpowers/plans/"
  missing=1
else
  print "OK  docs/exec-plans retired"
fi

if [[ -L "docs/architecture.md" && "$(readlink docs/architecture.md)" == "ARCHITECTURE.md" ]]; then
  print "OK  docs/architecture.md compatibility symlink"
else
  print "MISS docs/architecture.md must be a symlink to ARCHITECTURE.md"
  missing=1
fi

if find docs/superpowers -maxdepth 1 -type f | rg -q .; then
  print "MISS docs/superpowers root must not contain loose markdown files"
  find docs/superpowers -maxdepth 1 -type f -print
  missing=1
else
  print "OK  docs/superpowers root has no loose files"
fi

if find docs/superpowers/plans -mindepth 1 -maxdepth 1 -type d | rg -q .; then
  print "MISS docs/superpowers/plans must stay flat for superpowers:writing-plans compatibility"
  find docs/superpowers/plans -mindepth 1 -maxdepth 1 -type d -print
  missing=1
else
  print "OK  docs/superpowers/plans stays flat"
fi

typeset -a allowed_root_docs=(
  "docs/ARCHITECTURE.md"
  "docs/architecture.md"
  "docs/clawscale_bridge.md"
  "docs/deploy.md"
  "docs/roadmap.md"
  "docs/release-guide.md"
  "docs/RELEASE_CHECKLIST.md"
)
typeset -A allowed_root_doc_map
for file in "${allowed_root_docs[@]}"; do
  allowed_root_doc_map[$file]=1
done

unexpected_root_docs=0
while IFS= read -r file; do
  if [[ -z "${allowed_root_doc_map[$file]:-}" ]]; then
    print "MISS unexpected root doc $file; move runbooks/issues/specs into canonical subdirectories"
    unexpected_root_docs=1
  fi
done < <(find docs -maxdepth 1 \( -type f -o -type l \) -name "*.md" | sort)
if [[ "$unexpected_root_docs" -ne 0 ]]; then
  missing=1
else
  print "OK  docs root markdown allowlist"
fi

if ! "$python_cmd" scripts/guardrails.py check-import-boundaries; then
  missing=1
fi

if ! "$python_cmd" scripts/guardrails.py check-ownership-registry; then
  missing=1
fi

for needle in \
  "docs/design-docs/index.md" \
  "docs/fitness/README.md" \
  "docs/fitness/coke-verification-matrix.md" \
  "docs/fitness/surfaces.yaml" \
  "docs/design-docs/human-ai-working-contract.md" \
  "docs/ARCHITECTURE.md" \
  "docs/issues/" \
  "docs/product-specs/FEATURE_TREE.md" \
  "docs/release-guide.md" \
  "docs/RELEASE_CHECKLIST.md" \
  "docs/superpowers/plans/" \
  "docs/superpowers/specs/" \
  "artifacts/evidence/"
do
  if rg -q "$needle" AGENTS.md CLAUDE.md; then
    print "OK  root docs reference $needle"
  else
    print "MISS root docs reference $needle"
    missing=1
  fi
done

for needle in "AGENTS.md" "docs/design-docs/index.md"; do
  if rg -q "$needle" README.md; then
    print "OK  README points to $needle"
  else
    print "MISS README points to $needle"
    missing=1
  fi
done

if [[ "$missing" -ne 0 ]]; then
  print "check failed"
  exit 1
fi

print "check passed"
