#!/usr/bin/env zsh

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

dry_run=0

if [[ -x ".venv/bin/python" ]]; then
  pytest_cmd=".venv/bin/python -m pytest"
elif command -v python3 >/dev/null 2>&1; then
  pytest_cmd="python3 -m pytest"
else
  pytest_cmd="python -m pytest"
fi

if [[ "${1:-}" == "--dry-run" ]]; then
  dry_run=1
  shift
fi

if [[ "$#" -eq 0 ]]; then
  print -u2 "usage: scripts/verify-surface [--dry-run] <surface> [surface...]"
  exit 1
fi

surface_commands() {
  local surface="$1"

  case "$surface" in
    clean-rebuild-docs)
      print "bash scripts/e2e/clean-rebuild-canonical-doc-sync.sh"
      print "zsh scripts/check"
      ;;
    clean-rebuild-backend)
      print "$pytest_cmd tests/unit/coke -v"
      ;;
    clean-rebuild-web)
      print "cd gateway && pnpm --filter @coke/web test"
      print "cd gateway && pnpm --filter @coke/web build"
      ;;
    repo-os-docs)
      print "zsh scripts/check"
      ;;
    repo-os)
      print "$pytest_cmd tests/unit/test_repo_os_structure.py -v"
      print "$pytest_cmd tests/unit/test_guardrail_scripts.py -v"
      print "zsh scripts/check"
      ;;
    worker-runtime)
      print "$pytest_cmd tests/unit/runner/ -v"
      print "$pytest_cmd tests/unit/agent/ -v"
      print "$pytest_cmd tests/unit/test_clawscale_only_topology.py -v"
      ;;
    product-reminder)
      print "$pytest_cmd tests/unit/reminder/ tests/unit/agent/test_reminder_intent_capability.py tests/unit/agent/test_reminder_command_executor.py tests/unit/runner/test_reminder_event_handler.py tests/unit/runner/test_reminder_scheduler.py -v"
      ;;
    product-memo)
      print "$pytest_cmd tests/unit/agent/test_memo_capability_adapter.py -v"
      print "$pytest_cmd memo-runtime/tests -v"
      ;;
    product-calendar-import)
      print "$pytest_cmd tests/unit/agent/test_calendar_import_handoff_tool.py tests/unit/connector/clawscale_bridge/test_google_calendar_import_service.py -v"
      print "pnpm --dir gateway/packages/api test calendar-import"
      ;;
    product-timezone)
      print "$pytest_cmd tests/unit/agent/test_timezone_port.py tests/unit/agent/test_timezone_service.py tests/unit/test_timezone_tools.py tests/unit/test_user_dao_timezone.py -v"
      ;;
    bridge)
      print "$pytest_cmd tests/unit/connector/clawscale_bridge/ -v"
      print "$pytest_cmd tests/unit/agent/test_message_util_clawscale_routing.py -v"
      ;;
    gateway-api)
      print "pnpm --dir gateway/packages/api test"
      ;;
    gateway-web)
      print "pnpm --dir gateway/packages/web test"
      ;;
    deploy)
      print "bash scripts/test-deploy-compose-to-gcp.sh"
      print "zsh scripts/check"
      ;;
    *)
      return 1
      ;;
  esac
}

for surface in "$@"; do
  if ! surface_cmds="$(surface_commands "$surface")"; then
    print -u2 "unknown_surface:$surface"
    exit 1
  fi

  print "== $surface =="

  while IFS= read -r command; do
    [[ -z "$command" ]] && continue
    print "$command"
    if [[ "$dry_run" -eq 0 ]]; then
      eval "$command"
    fi
  done <<< "$surface_cmds"
done
