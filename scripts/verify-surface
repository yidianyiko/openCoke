#!/usr/bin/env zsh

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

dry_run=0

if [[ -x ".venv/bin/python" ]]; then
  pytest_cmd=".venv/bin/python -m pytest"
elif command -v python3 >/dev/null 2>&1; then
  pytest_cmd="python3 -m pytest"
else
  pytest_cmd="python -m pytest"
fi

if [[ "${1:-}" == "--dry-run" ]]; then
  dry_run=1
  shift
fi

if [[ "$#" -eq 0 ]]; then
  print -u2 "usage: scripts/verify-surface [--dry-run] <surface> [surface...]"
  exit 1
fi

surface_commands() {
  local surface="$1"

  case "$surface" in
    clean-rebuild-docs)
      print "bash scripts/e2e/clean-rebuild-canonical-doc-sync.sh"
      print "zsh scripts/check"
      ;;
    clean-rebuild-backend)
      print "$pytest_cmd tests/unit/coke -v"
      ;;
    clean-rebuild-web)
      print "cd web && pnpm test"
      print "cd web && pnpm build"
      ;;
    repo-os-docs)
      print "zsh scripts/check"
      ;;
    repo-os)
      print "$pytest_cmd tests/unit/coke/test_clean_rebuild_no_legacy_imports.py -v"
      print "zsh scripts/check"
      ;;
    deploy)
      print "zsh scripts/check"
      ;;
    *)
      return 1
      ;;
  esac
}

for surface in "$@"; do
  if ! surface_cmds="$(surface_commands "$surface")"; then
    print -u2 "unknown_surface:$surface"
    exit 1
  fi

  print "== $surface =="

  while IFS= read -r command; do
    [[ -z "$command" ]] && continue
    print "$command"
    if [[ "$dry_run" -eq 0 ]]; then
      eval "$command"
    fi
  done <<< "$surface_cmds"
done
